# Settings for `docker compose up`. docker compose reads a file named .env in this folder.
#
# Do not copy this file and keep the placeholder values. Generate real secrets
# with this one command (run it in the project folder):
#
#   printf 'POSTGRES_PASSWORD=%s\nJWT_ACCESS_SECRET=%s\nIP_HASH_SALT=%s\n' \
#     "$(openssl rand -hex 16)" "$(openssl rand -hex 32)" "$(openssl rand -hex 32)" > .env
#
# .env is git-ignored. Never commit it.

# Password of the Postgres user inside the compose network.
POSTGRES_PASSWORD=

# Signs login tokens. Anyone who knows it can impersonate any user. At least 32 characters.
JWT_ACCESS_SECRET=

# Mixed into visitor IP hashes. At least 32 characters.
IP_HASH_SALT=

# Optional: the public address of the site. Short links are built from it.
# BASE_URL=https://lnk.example.com
