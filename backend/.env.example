# Copy this file to .env and fill in DATABASE_URL. Everything else has a working default for local development.

NODE_ENV=development
PORT=5001

# Public address of this API. Short links are built from it.
BASE_URL=http://localhost:5001

# Web origins allowed to call the API (comma separated). The first one is the web app.
CORS_ORIGIN=http://localhost:5173

# Number of reverse proxies in front of the API (nginx, load balancer). 0 when you run it directly.
TRUST_PROXY=0

# PostgreSQL: local Docker, Neon, or any other Postgres.
#   Docker:  postgresql://linkforge:linkforge@localhost:5432/linkforge
#   Neon:    postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://linkforge:linkforge@localhost:5432/linkforge
DATABASE_POOL_MAX=10

# How to reach PostgreSQL:
#   pg              standard protocol on port 5432 (default; Docker, CI, production)
#   neon-websocket  Neon only: tunnels over port 443. Use it if connecting to Neon fails with
#                   ECONNRESET, which means your network blocks PostgreSQL traffic on 5432.
# DATABASE_DRIVER=pg

# Redis: link cache + rate limiting. Optional in development (the app falls back to Postgres-only lookups
# and in-process rate limits), required for production.
#   Docker:   redis://localhost:6379
#   Upstash:  rediss://default:password@xxxx.upstash.io:6379
REDIS_URL=redis://localhost:6379

# Secrets. Development uses built-in values when these are empty.
# In production both are REQUIRED. Generate each with:  openssl rand -base64 48
# JWT_ACCESS_SECRET=
# IP_HASH_SALT=

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
