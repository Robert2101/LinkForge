# Application Environment
NODE_ENV=development
PORT=5001
BASE_URL=http://localhost:5001
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Authentication Secrets (Generate strong random secrets in production: openssl rand -base64 32)
JWT_ACCESS_SECRET=linkforge-dev-access-super-secret-key-32chars!
JWT_REFRESH_SECRET=linkforge-dev-refresh-super-secret-key-32chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=linkforge-dev-cookie-secret-min16chars!

# Redis (Optional: Leave empty for high-performance in-memory fallback)
# REDIS_URL=redis://default:token@region.upstash.io:6379