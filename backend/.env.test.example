# Settings for `npm test`. Copy this file to .env.test.
#
# Tests create real users and links, so they get their own throwaway database
# and Redis, started with:
#
#   docker compose -f docker-compose.test.yml up -d      (run in the project root)
#
# Never point these at a database you care about.

NODE_ENV=test
BASE_URL=http://localhost:5001
DATABASE_URL=postgresql://linkforge:linkforge@localhost:5433/linkforge_test
REDIS_URL=redis://localhost:6380/1

# Lets each test pretend to be a different visitor via the X-Forwarded-For header.
TRUST_PROXY=1
