{
  "name": "linkforge-backend",
  "version": "1.0.0",
  "description": "LinkForge API: URL shortening, redirects and click analytics",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "test": "node --env-file-if-exists=.env.test --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:migrate": "node --env-file-if-exists=.env.test src/db/migrate.js",
    "lint": "eslint .",
    "bench": "node --env-file-if-exists=.env scripts/bench-redirect.js"
  },
  "author": "Robert",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "ua-parser-js": "^2.0.10",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=22"
  }
}
