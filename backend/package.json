{
  "name": "linkforge-backend",
  "version": "0.1.0",
  "description": "LinkForge backend — URL shortener API",
  "main": "src/server.js",
  "scripts": {
    "test": "node --test --env-file=.env tests/**/*.test.js",
    "start": "node src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env src/db/migrate.js",
